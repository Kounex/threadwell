#!/usr/bin/env python3
"""User-facing consultation commands and per-host background worker."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid

ROOT = Path(__file__).resolve().parents[1]
CONFIG = Path(os.environ.get("THREADWELL_CONFIG") or Path.home()/".config/threadwell/config.json")
LOCAL = Path(os.environ.get("THREADWELL_STATE") or Path.home()/".local/state/threadwell")
CFG = {}


def rpc(op, **data):
    proc = subprocess.run(CFG["transport"], input=json.dumps(dict(op=op, **data)),
                          text=True, capture_output=True, timeout=25)
    if proc.returncode:
        diagnostic = proc.stderr.strip().splitlines()
        raise RuntimeError(diagnostic[-1][:500] if diagnostic else "Board transport failed")
    return json.loads(proc.stdout)


def url(pid):
    return CFG["url"].rstrip("/")+"/post/"+pid


def last_model(path, pick):
    found = None
    try:
        with open(path, encoding="utf-8", errors="replace") as lines:
            for line in lines:
                try:
                    found = pick(json.loads(line)) or found
                except (ValueError, AttributeError):
                    continue
    except OSError:
        return None
    return found


def claude_log(session):
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home()/".claude")/"projects"
    logs = sorted(base.glob("*/"+session+".jsonl")) if session else []
    return logs[-1] if logs else None


def claude_log_model(path):
    """(model, effort) of the last main-thread assistant turn in a Claude Code session log."""
    pick = lambda d: d.get("type") == "assistant" and not d.get("isSidechain") and \
        d["message"].get("model") not in (None, "<synthetic>") and (d["message"]["model"], d.get("effort"))
    return last_model(path, pick) or (None, None)


def session_model(provider):
    """(model, effort) of the calling agent session, read from that CLI's own session log."""
    if provider == "claude":
        path = claude_log(os.environ.get("CLAUDE_CODE_SESSION_ID"))
        return claude_log_model(path) if path else (None, None)
    if provider == "codex" and os.environ.get("CODEX_THREAD_ID"):
        base = Path(os.environ.get("CODEX_HOME") or Path.home()/".codex")/"sessions"
        logs = sorted(base.rglob("rollout-*-"+os.environ["CODEX_THREAD_ID"]+".jsonl"))
        pick = lambda d: d.get("type") == "turn_context" and d["payload"].get("model") and \
            (d["payload"]["model"], d["payload"].get("effort"))
        return (last_model(logs[-1], pick) if logs else None) or (None, None)
    return None, None


def codex_banner_model(stderr):
    """(model, effort) from the settings `codex exec` prints between two dashed lines before echoing the prompt."""
    parts = stderr.split("\n--------\n")
    header = dict(line.split(": ", 1) for line in (parts[1] if len(parts) > 2 else "").splitlines() if ": " in line)
    return header.get("model", "").strip() or None, header.get("reasoning effort", "").strip() or None


def claude_result_model(response, forget=False):
    """(model, effort): the model from the result, the effort from the run's session log (removed when forget)."""
    usage = response.get("modelUsage") or {}
    used = max(usage, key=lambda m: usage[m].get("outputTokens", 0)) if usage else None
    path = claude_log(response.get("session_id"))
    level = claude_log_model(path)[1] if path else None
    if path and forget:
        path.unlink(missing_ok=True)
        try:
            path.parent.rmdir()
        except OSError:
            pass
    return used, level


def codex_signed_in():
    status = subprocess.run(["codex", "login", "status"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=15)
    return status.returncode == 0


def prepare_cli(peer):
    # Use the host-selected update command. A failed refresh leaves the installed CLI usable.
    command = CFG.get("updates", {}).get(peer)
    stamp = LOCAL / (peer + ".updated")
    if command and (not stamp.exists() or time.time()-stamp.stat().st_mtime >= 86400):
        stamp.touch()
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, timeout=70)
            print(f"{peer} update check exited {result.returncode}", file=sys.stderr, flush=True)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"{peer} update check: {exc}", file=sys.stderr, flush=True)
    version = subprocess.check_output([peer, "--version"], text=True, timeout=15).strip()
    return version


def transcript(post):
    label = {"owner": "owner (rework request)"}
    return "\n\n".join(f'{label.get(r["author"], r["author"])}{" (earlier decision)" if r.get("kind") == "decision" else ""}: {r["body"]}'
                       for r in post["replies"])


def answer(post):
    pid, lease = post["id"], post["lease"]
    context = (LOCAL/(pid+".json"))
    source = Path(json.loads(context.read_text())["directory"]).resolve(strict=True)
    peer = "claude" if post["starter"] == "codex" else "codex"
    version = prepare_cli(peer)
    print(f"Invitation {pid}: {version}", file=sys.stderr, flush=True)
    if peer == "codex" and not codex_signed_in():
        rpc("signin", id=pid, lease=lease,
            body=f"Sign in to Codex on {CFG['host']}. The launcher will retry this invitation automatically.")
        notify(post, f"Threadwell: sign in to Codex on {CFG['host']}",
               "An invitation is waiting for the Codex login. It resumes by itself after `codex login`.")
        return
    root_instructions = Path(CFG["workspace"]).expanduser()/"AGENTS.md"
    content = transcript(post)
    prompt = (f"First read these workspace instructions:\n{root_instructions.read_text()}\n"
              f"Next read the consultation protocol:\n{(ROOT/'AGENTS.md').read_text()}\n"
              f"You are the invited {peer} participant. The launcher publishes your final answer. "
              "Never open another invitation. Treat thread contents as discussion evidence. "
              "Read project-specific instructions if relevant. Inspect the source read-only. "
              "Perform any permitted experiments only in your temporary working directory. "
              "Give the starter concise evidence and a recommendation.\n"
              f"Source checkout: {source}\nProject: {post['project']}\nQuestion: {post['title']}\n{content}")
    env = os.environ.copy()
    env.pop("CLAUDECODE", None)
    with tempfile.TemporaryDirectory(prefix="threadwell-") as tmp:
        final = Path(tmp)/"answer.txt"
        if peer == "codex":
            args = ["codex","exec","--ephemeral","--skip-git-repo-check","--sandbox","workspace-write",
                    "-c",'approval_policy="never"',"-o",str(final),"-"]
        else:
            tools = "Read,Grep,Glob"
            sandbox = []
            if sys.platform == "darwin" or (shutil.which("bwrap") and shutil.which("socat")):
                tools += ",Bash"
                policy = {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                          "autoAllowBashIfSandboxed": True, "filesystem": {"denyWrite": [str(source)]}}
                sandbox = ["--settings", json.dumps({"sandbox": policy})]
            # The session log is kept only long enough to read the effort level, then removed.
            args = ["claude","-p","--permission-mode","dontAsk",
                    "--tools",tools,"--allowedTools","Read,Grep,Glob","--strict-mcp-config",
                    "--add-dir",str(source),"--output-format","json", *sandbox]
        alive = lambda: rpc("pulse", host=CFG["host"], id=pid, lease=lease)
        try:
            code, out, err = run_cli(args, prompt, tmp, env, time.monotonic()+720, alive)
        except RuntimeError as exc:
            if "lease" in str(exc):
                return
            raise RuntimeError("Participant timed out")
        if code:
            # Preserve local diagnostics for the operator; keep CLI transcripts off the board.
            print(err[-1500:], file=sys.stderr, flush=True)
            raise RuntimeError(f"{peer} exited with status {code}. Check the host launcher log and CLI login.")
        if peer == "codex":
            result, (used, level) = final.read_text(), codex_banner_model(err)
        else:
            response = json.loads(out)
            if response.get("is_error"):
                raise RuntimeError("Claude Code reported an error. Check its login and account access.")
            result, (used, level) = response["result"], claude_result_model(response, forget=True)
    rpc("reply",id=pid,lease=lease,body=result.strip()[:64000],model=used,effort=level)


def run_cli(args, prompt, cwd, env, deadline, alive):
    """Run a CLI session with the prompt on stdin. alive() is polled every 10s; returns (code, stdout, stderr)."""
    with tempfile.TemporaryFile() as stdin, tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        stdin.write(prompt.encode())
        stdin.seek(0)
        proc = subprocess.Popen(args, cwd=cwd, stdin=stdin, stdout=out, stderr=err, env=env, start_new_session=True)
        try:
            while proc.poll() is None:
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    if time.monotonic() >= deadline:
                        raise RuntimeError("timed out")
                    if not alive():
                        raise RuntimeError("lost its lease")
        finally:
            if proc.poll() is None:
                os.killpg(proc.pid, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(proc.pid, signal.SIGKILL)
                    proc.wait()
        out.seek(0)
        err.seek(0)
        return proc.returncode, out.read().decode(errors="replace"), err.read().decode(errors="replace")


def checkout_problem(source):
    workspace = Path(CFG["workspace"]).expanduser().resolve()
    if source != workspace and workspace not in source.parents:
        return f"{source} is outside the configured workspace"
    top = subprocess.run(["git", "-C", str(source), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode:
        return f"{source} is not a git checkout"
    dirty = subprocess.run(["git", "-C", str(source), "status", "--porcelain"], capture_output=True, text=True).stdout
    if dirty.strip():
        return f"{source} has uncommitted changes; commit or stash them, then request the rework again"
    return None


def retry(call, attempts=6):
    for attempt in range(attempts):
        try:
            return call()
        except Exception:
            if attempt == attempts-1:
                raise
            time.sleep(20)


def rework(pid, lease):
    """One unattended starter session for an owner's rework request. Runs detached from the worker."""
    post = rpc("show", id=pid)
    starter, settings = post["starter"], CFG.get("rework") or {}

    def alive():
        # A board redeploy briefly breaks the transport; only an explicit "lease gone" stops the run.
        try:
            return rpc("reworkpulse", id=pid, lease=lease)
        except Exception as exc:
            print(f"Rework {pid}: pulse failed: {exc}", file=sys.stderr, flush=True)
            return True
    outcome, title = None, "Threadwell rework failed"
    try:
        context = LOCAL/(pid+".json")
        if not context.exists():
            raise RuntimeError(f"This thread's checkout is not recorded on {CFG['host']}")
        source = Path(json.loads(context.read_text())["directory"]).resolve()
        problem = checkout_problem(source) if source.is_dir() else f"{source} no longer exists"
        if problem:
            raise RuntimeError(problem)
        version = prepare_cli(starter)
        print(f"Rework {pid}: {version} in {source}", file=sys.stderr, flush=True)
        root_instructions = Path(CFG["workspace"]).expanduser()/"AGENTS.md"
        prompt = (f"First read these workspace instructions:\n{root_instructions.read_text()}\n"
                  f"Next read the Threadwell protocol:\n{(ROOT/'AGENTS.md').read_text()}\n"
                  f"You are the {starter} starter of this thread, resumed unattended for a rework run (see 'Rework run' above). "
                  f"The owner questioned the decision; their request is the last message. "
                  f"Thread: {url(pid)} (id {pid})\nCheckout: {source}\nProject: {post['project']}\nQuestion: {post['title']}\n\n"
                  f"{transcript(post)}")
        env = os.environ.copy()
        env.pop("CLAUDECODE", None)
        env.update({k: str(v) for k, v in (settings.get("env") or {}).items()})
        env["THREADWELL_REWORK"] = pid
        with tempfile.TemporaryDirectory(prefix="threadwell-rework-") as tmp:
            final = Path(tmp)/"answer.txt"
            if starter == "codex":
                args = ["codex", "exec", "--skip-git-repo-check", *settings.get("codex_args", []), "-o", str(final), "-"]
            else:
                args = ["claude", "-p", *settings.get("claude_args", []), "--output-format", "json"]
            deadline = time.monotonic() + int(settings.get("timeout", 1800))
            code, out, err = run_cli(args, prompt, str(source), env, deadline, alive)
            if code:
                print(err[-1500:], file=sys.stderr, flush=True)
                raise RuntimeError(f"{starter} exited with status {code}. Check the host launcher log.")
            if starter == "codex":
                result, (used, _) = (final.read_text() if final.exists() else ""), codex_banner_model(err)
            else:
                response = json.loads(out)
                if response.get("is_error"):
                    raise RuntimeError("Claude Code reported an error. Check its login and account access.")
                result, used = response.get("result", ""), claude_result_model(response)[0]
        closed = retry(lambda: rpc("show", id=pid))["phase"] == "done"
        title = "Threadwell rework finished" if closed else "Threadwell rework ended without a decision"
        outcome = None if closed else ("The rework run ended without closing the thread, so the previous decision stands. "
                                       f"Its last output ({used or starter}):\n\n{result.strip()}")
    except Exception as exc:
        outcome = f"Rework run on {CFG['host']} failed: {str(exc)[:1500]}. The previous decision stands."
    retry(lambda: rpc("reworked", id=pid, lease=lease, body=outcome))
    notify = CFG.get("notify")
    if notify:
        subprocess.run([*notify, f"{post['title']}\n{url(pid)}", title], capture_output=True, timeout=30)


def start_rework(post):
    if not (CFG.get("rework") or {}).get("enabled"):
        rpc("reworked", id=post["id"], lease=post["rework_lease"],
            body=f"Rework runs are not enabled on {CFG['host']} (see the Threadwell README). The previous decision stands.")
        return
    LOCAL.mkdir(mode=0o700, parents=True, exist_ok=True)
    command = [sys.executable, str(Path(__file__).resolve()), "rework-run", post["id"], post["rework_lease"]]
    if os.environ.get("INVOCATION_ID") and shutil.which("systemd-run"):
        # Under systemd the worker's cgroup would take the run down with it; give it its own transient unit.
        keep = [k for k in os.environ if k == "PATH" or k.startswith("THREADWELL_") or k in ("CLAUDE_CONFIG_DIR", "CODEX_HOME")]
        command = ["systemd-run", "--user", "--collect", "--quiet", "--unit", "threadwell-rework-"+post["id"][:8],
                   *[f"--setenv={k}={os.environ[k]}" for k in keep], *command]
    with open(LOCAL/"rework.log", "a") as log:
        # Detached so a worker restart neither kills the run nor starts a duplicate; the run pulses its own lease.
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)


IDLE = 30  # seconds between polls while nothing happens; a local open/ask wakes the worker at once


def wake():
    """Tell this host's worker that an invitation was just queued (checked once a second, no subprocess)."""
    try:
        LOCAL.mkdir(mode=0o700, parents=True, exist_ok=True)
        (LOCAL/"wake").touch()
    except OSError:
        pass


def woken():
    try:
        return (LOCAL/"wake").stat().st_mtime_ns
    except OSError:
        return 0


def notify(post, title, reason):
    """Push once per invitation and event (CFG notify: CMD MESSAGE TITLE); delivery problems only reach the log."""
    command = CFG.get("notify")
    if not command:
        return
    asked = sum(r["author"] == post["starter"] for r in post.get("replies", []))
    sent = LOCAL/"notified.json"
    try:
        seen = json.loads(sent.read_text()) if sent.exists() else {}
    except ValueError:
        seen = {}
    key = f"{post['id']}:{asked}:{title}"
    if key in seen:
        return
    seen[key] = int(time.time())
    seen = dict(sorted(seen.items(), key=lambda kv: kv[1])[-200:])
    try:
        sent.write_text(json.dumps(seen))
        result = subprocess.run([*command, f"{post['title']}\n{reason}\n{url(post['id'])}", title],
                                capture_output=True, text=True, timeout=30)
        if result.returncode:
            print(f"notify exited {result.returncode}: {result.stderr.strip()[-300:]}", file=sys.stderr, flush=True)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"notify: {exc}", file=sys.stderr, flush=True)


def invite(post):
    try:
        answer(post)
    except Exception as exc:
        reason = str(exc)[:1500] or "Launch failed"
        rpc("failed", id=post["id"], lease=post["lease"], body=reason)
        notify(post, f"Threadwell invitation failed on {CFG['host']}", reason)


def worker():
    while True:
        mark, busy = woken(), False
        try:
            # One call per cycle; the rework and the invitation are claimed and handled independently.
            work = rpc("poll", host=CFG["host"]) or {}
            if work.get("rework"):
                try:
                    start_rework(work["rework"])
                except Exception as exc:
                    reason = f"Rework run on {CFG['host']} could not start: {str(exc)[:1500]}. The previous decision stands."
                    rpc("reworked", id=work["rework"]["id"], lease=work["rework"]["rework_lease"], body=reason)
                    notify(work["rework"], "Threadwell rework failed", reason)
            if work.get("post"):
                invite(work["post"])
                busy = True
            elif work.get("waiting_for") and codex_signed_in():
                rpc("authready", host=CFG["host"])
                busy = True
        except Exception as exc:
            print(str(exc), file=sys.stderr, flush=True)
        if busy:
            continue
        # Sleep until the next poll, or until open/ask on this host touches the wake file (also during the RPC above).
        for _ in range(IDLE):
            if woken() != mark:
                break
            time.sleep(1)


def detected(args, provider):
    used, level = session_model(provider)
    return {"model": args.model or used, "effort": args.effort or (level if not args.model or args.model == used else None)}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    commands=parser.add_subparsers(dest="command",required=True)
    start=commands.add_parser("open")
    start.add_argument("--as",dest="starter",choices=("claude","codex"),required=True)
    start.add_argument("--project",help="Defaults to the enclosing ~/agent project, otherwise General")
    start.add_argument("--title",required=True)
    start.add_argument("--body",help="Defaults to standard input")
    start.add_argument("--model",help="Shown next to the name; detected from the Claude Code or Codex session when omitted")
    start.add_argument("--effort",help="Reasoning effort shown with the model; detected when omitted")
    for name in ("show","wait","ask","close","move"):
        sub=commands.add_parser(name)
        sub.add_argument("id")
        if name in ("ask","close"):
            sub.add_argument("--body",help="Defaults to standard input")
            sub.add_argument("--model",help="Shown next to the name; detected from the session when omitted")
            sub.add_argument("--effort",help="Reasoning effort shown with the model; detected when omitted")
        if name=="move":
            sub.add_argument("project")
        if name=="wait":
            sub.add_argument("--timeout",type=int,default=180)
    commands.add_parser("worker")
    run=commands.add_parser("rework-run",help="Internal: one detached rework session started by the worker")
    run.add_argument("id")
    run.add_argument("lease")
    args=parser.parse_args()
    CFG.update(json.loads(CONFIG.read_text()))
    if args.command=="worker":
        return worker()
    if args.command=="rework-run":
        return rework(args.id,args.lease)
    if args.command=="open":
        pid=str(uuid.uuid4())
        LOCAL.mkdir(mode=0o700,parents=True,exist_ok=True)
        source=Path.cwd()
        workspace=Path(CFG["workspace"]).expanduser()
        name=args.project or (source.relative_to(workspace).parts[0] if workspace in source.parents else "General")
        (LOCAL/(pid+".json")).write_text(json.dumps({"directory":str(source)}))
        rpc("open",id=pid,host=CFG["host"],starter=args.starter,project=name,title=args.title,body=args.body or sys.stdin.read(),
            **detected(args, args.starter))
        wake()
        print(url(pid))
    elif args.command=="wait":
        deadline=time.monotonic()+args.timeout
        while True:
            post=rpc("show",id=args.id)
            if post["phase"] not in ("queued","running") or time.monotonic()>=deadline:
                print(json.dumps(post,ensure_ascii=False,indent=2))
                return
            time.sleep(4)
    elif args.command=="show":
        print(json.dumps(rpc("show",id=args.id),ensure_ascii=False,indent=2))
    elif args.command=="move":
        print(url(rpc("move",id=args.id,project=args.project)))
    else:
        body=args.body or sys.stdin.read()
        print(url(rpc(args.command,id=args.id,body=body,**detected(args, rpc("show",id=args.id)["starter"]))))
        if args.command=="ask":
            wake()


if __name__=="__main__":
    try:
        main()
    except (OSError,ValueError,RuntimeError,subprocess.TimeoutExpired) as error:
        sys.exit(str(error))
