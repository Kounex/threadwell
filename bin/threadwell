#!/usr/bin/env python3
"""User-facing consultation commands and per-host background worker."""
import argparse
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid

ROOT = Path(__file__).resolve().parents[1]
CONFIG = Path(os.environ.get("THREADWELL_CONFIG") or Path.home()/".config/threadwell/config.json")
LOCAL = Path(os.environ.get("THREADWELL_STATE") or Path.home()/".local/state/threadwell")
CFG = {}


def rpc(op, **data):
    proc = subprocess.run(CFG["transport"], input=json.dumps(dict(op=op, **data)),
                          text=True, capture_output=True, timeout=25)
    if proc.returncode:
        diagnostic = proc.stderr.strip().splitlines()
        raise RuntimeError(diagnostic[-1][:500] if diagnostic else "Board transport failed")
    return json.loads(proc.stdout)


def url(pid):
    return CFG["url"].rstrip("/")+"/post/"+pid


def last_model(path, pick):
    found = None
    try:
        with open(path, encoding="utf-8", errors="replace") as lines:
            for line in lines:
                try:
                    found = pick(json.loads(line)) or found
                except (ValueError, AttributeError):
                    continue
    except OSError:
        return None
    return found


def claude_log(session):
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home()/".claude")/"projects"
    logs = sorted(base.glob("*/"+session+".jsonl")) if session else []
    return logs[-1] if logs else None


def claude_log_model(path):
    """(model, effort) of the last main-thread assistant turn in a Claude Code session log."""
    pick = lambda d: d.get("type") == "assistant" and not d.get("isSidechain") and \
        d["message"].get("model") not in (None, "<synthetic>") and (d["message"]["model"], d.get("effort"))
    return last_model(path, pick) or (None, None)


def session_model(provider):
    """(model, effort) of the calling agent session, read from that CLI's own session log."""
    if provider == "claude":
        path = claude_log(os.environ.get("CLAUDE_CODE_SESSION_ID"))
        return claude_log_model(path) if path else (None, None)
    if provider == "codex" and os.environ.get("CODEX_THREAD_ID"):
        base = Path(os.environ.get("CODEX_HOME") or Path.home()/".codex")/"sessions"
        logs = sorted(base.rglob("rollout-*-"+os.environ["CODEX_THREAD_ID"]+".jsonl"))
        pick = lambda d: d.get("type") == "turn_context" and d["payload"].get("model") and \
            (d["payload"]["model"], d["payload"].get("effort"))
        return (last_model(logs[-1], pick) if logs else None) or (None, None)
    if provider == "antigravity":
        # agy exposes no session id to the commands it runs; report the host's configured default.
        return agy_model(), None
    return None, None


def codex_banner_model(stderr):
    """(model, effort) from the settings `codex exec` prints between two dashed lines before echoing the prompt."""
    parts = stderr.split("\n--------\n")
    header = dict(line.split(": ", 1) for line in (parts[1] if len(parts) > 2 else "").splitlines() if ": " in line)
    return header.get("model", "").strip() or None, header.get("reasoning effort", "").strip() or None


def claude_result_model(response, forget=False):
    """(model, effort): the model from the result, the effort from the run's session log (removed when forget)."""
    usage = response.get("modelUsage") or {}
    used = max(usage, key=lambda m: usage[m].get("outputTokens", 0)) if usage else None
    path = claude_log(response.get("session_id"))
    level = claude_log_model(path)[1] if path else None
    if path and forget:
        path.unlink(missing_ok=True)
        try:
            path.parent.rmdir()
        except OSError:
            pass
    return used, level


def codex_signed_in():
    status = subprocess.run(["codex", "login", "status"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=15)
    return status.returncode == 0


def child_env(extra=None):
    """Environment for a CLI session started by the launcher."""
    env = os.environ.copy()
    env.pop("CLAUDECODE", None)
    # UGOS gives every systemd service GODEBUG=tlskyber=0; Go 1.24+ binaries such as agy refuse to start with it.
    debug = [item for item in env.get("GODEBUG", "").split(",") if item and not item.startswith("tlskyber=")]
    if debug:
        env["GODEBUG"] = ",".join(debug)
    else:
        env.pop("GODEBUG", None)
    env.update(extra or {})
    return env


def agy_model():
    return CFG.get("models", {}).get("antigravity") or "gemini-4-carbon-high"


def agy_stdin(prompt):
    # `agy -p` takes the prompt only as an argument (128 KiB at most); stream-json reads it from standard input.
    return json.dumps({"event": "user", "message": {"content": prompt}}) + "\n"


def agy_result(out):
    """(answer, model) from agy's stream-json events; raises unless the turn succeeded with an answer."""
    used, result = None, None
    for line in out.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("event") == "init":
            used = (event.get("init") or {}).get("model") or used
        elif event.get("event") == "result":
            result = event.get("result") or {}
    if not result:
        raise RuntimeError("Antigravity ended without a result. Check the host launcher log and `agy` login.")
    forget_agy(result.get("conversation_id"))
    if result.get("status") != "SUCCESS" or not (result.get("response") or "").strip():
        raise RuntimeError(f"Antigravity reported {result.get('status') or 'no status'}: "
                           f"{(result.get('error') or 'empty answer')[:300]}")
    return result["response"], used or agy_model()


def forget_agy(conversation):
    """Remove an invited agy session's local conversation, as the Claude path removes its session log."""
    if not conversation or not all(c in "0123456789abcdef-" for c in conversation):
        return
    base = Path.home()/".gemini/antigravity-cli"
    shutil.rmtree(base/"brain"/conversation, ignore_errors=True)
    for path in (base/"conversations"/(conversation+".db"), base/"presence"/(conversation+".lock")):
        path.unlink(missing_ok=True)


def sandbox_ready():
    """agy's Linux sandbox needs unprivileged user namespaces; without them --sandbox silently does nothing."""
    if sys.platform == "darwin":
        return True
    probe = subprocess.run(["unshare", "--user", "--map-root-user", "true"], capture_output=True, timeout=15)
    return probe.returncode == 0


# How each CLI is invited, read and resumed. `participant` returns (argv, stdin); `parse` returns (answer, model, effort).
def claude_participant(source, tmp):
    tools = "Read,Grep,Glob"
    sandbox = []
    if sys.platform == "darwin" or (shutil.which("bwrap") and shutil.which("socat")):
        tools += ",Bash"
        policy = {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                  "autoAllowBashIfSandboxed": True, "filesystem": {"denyWrite": [str(source)]}}
        sandbox = ["--settings", json.dumps({"sandbox": policy})]
    # The session log is kept only long enough to read the effort level, then removed.
    return ["claude","-p","--permission-mode","dontAsk","--tools",tools,"--allowedTools","Read,Grep,Glob",
            "--strict-mcp-config","--add-dir",str(source),"--output-format","json", *sandbox]


def claude_parse(out, err, final, forget):
    response = json.loads(out)
    if response.get("is_error"):
        raise RuntimeError("Claude Code reported an error. Check its login and account access.")
    used, level = claude_result_model(response, forget=forget)
    return response.get("result", ""), used, level


def codex_parse(out, err, final, forget):
    used, level = codex_banner_model(err)
    return (final.read_text() if final.exists() else ""), used, level


def agy_participant(source, tmp):
    if not sandbox_ready():
        raise RuntimeError(f"Antigravity's sandbox isn't available on {CFG['host']} (no unprivileged user namespaces), "
                           "so it can't run as a read-only participant here")
    workspace = Path(CFG["workspace"]).expanduser().resolve()
    settings = {"permissions": {"deny": [f"write_file({workspace}/)", f"write_file({source}/)"]},
                "enableTerminalSandbox": True}
    return ["agy","--sandbox","--add-dir",str(source),"--settings",json.dumps(settings),"--model",agy_model(),
            "--input-format","stream-json","--output-format","stream-json"]


def agy_parse(out, err, final, forget):
    answer, used = agy_result(out)
    return answer, used, None


AGENTS = {
    "claude": dict(label="Claude Code", binary="claude", participant=claude_participant, parse=claude_parse,
                   rework=lambda extra, tmp: ["claude", "-p", *extra, "--output-format", "json"],
                   rework_args=["--permission-mode", "bypassPermissions"]),
    "codex": dict(label="Codex", binary="codex",
                  participant=lambda source, tmp: ["codex","exec","--ephemeral","--skip-git-repo-check","--sandbox",
                                                   "workspace-write","-c",'approval_policy="never"',"-o",
                                                   str(Path(tmp)/"answer.txt"),"-"],
                  parse=codex_parse,
                  rework=lambda extra, tmp: ["codex", "exec", "--skip-git-repo-check", *extra, "-o", str(Path(tmp)/"answer.txt"), "-"],
                  rework_args=["--dangerously-bypass-approvals-and-sandbox"]),
    "antigravity": dict(label="Antigravity", binary="agy", participant=agy_participant, parse=agy_parse, stdin=agy_stdin,
                        rework=lambda extra, tmp: ["agy", *extra, "--model", agy_model(),
                                              "--input-format", "stream-json", "--output-format", "stream-json"],
                        rework_args=["--dangerously-skip-permissions"]),
}


def label(agent):
    return AGENTS.get(agent, {}).get("label") or {"launcher": "Launcher", "owner": "Owner"}.get(agent, agent)


def host_agents():
    """Agents this host can invite: configured by setup, otherwise every known CLI found on PATH."""
    return CFG.get("agents") or [name for name, a in AGENTS.items() if shutil.which(a["binary"])]


def prepare_cli(peer):
    # Use the host-selected update command. A failed refresh leaves the installed CLI usable.
    command = CFG.get("updates", {}).get(peer)
    stamp = LOCAL / (peer + ".updated")
    if command and (not stamp.exists() or time.time()-stamp.stat().st_mtime >= 86400):
        stamp.touch()
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, timeout=70, env=child_env())
            print(f"{peer} update check exited {result.returncode}", file=sys.stderr, flush=True)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"{peer} update check: {exc}", file=sys.stderr, flush=True)
    binary = AGENTS[peer]["binary"]
    version = subprocess.check_output([binary, "--version"], text=True, timeout=15, env=child_env()).strip()
    return f"{binary} {version}" if not version.startswith(binary) else version


def transcript(post, replies=None):
    def who(r):
        name = "Owner (rework request)" if r["author"] == "owner" else label(r["author"])
        if r["author"] == post["starter"]:
            name += " (starter)"
        return name + {"decision": " (earlier decision)", "proposal": " (proposed decision)"}.get(r.get("kind"), "")
    return "\n\n".join(f'{who(r)}: {r["body"]}' for r in (post["replies"] if replies is None else replies))


PARTICIPANT_MINUTES = 15  # hard limit per participant turn; the board sweeps a silent one after 20


def answer(post):
    pid, lease, agent = post["id"], post["lease"], post.get("agent") or "codex"
    context = (LOCAL/(pid+".json"))
    source = Path(json.loads(context.read_text())["directory"]).resolve(strict=True)
    if agent not in AGENTS or agent not in host_agents():
        raise RuntimeError(f"{label(agent)} is not set up on {CFG['host']}")
    version = prepare_cli(agent)
    print(f"Invitation {pid} ({agent}): {version}", file=sys.stderr, flush=True)
    if agent == "codex" and not codex_signed_in():
        raise RuntimeError(f"Codex isn't signed in on {CFG['host']}. After `codex login` there, retry with "
                           f"`threadwell ask {pid} --to codex`.")
    # Everything up to this agent's turn: the round's question and the answers given before it.
    others = [label(a) for a in post["participants"] if a != agent]
    opening = next((r for r in post["replies"] if r["seq"] == post.get("round_seq")), {})
    stage = ("This is the review round: the starter's proposed decision opens it. Say whether you agree and raise "
             "any remarks, as 'Invited participant' describes. " if opening.get("kind") == "proposal" else
             "This is a proposal round: give your own approach, as 'Invited participant' describes. ")
    earlier = [r for r in post["replies"] if r["seq"] > (post.get("round_seq") or 0) and r["author"] in AGENTS]
    root_instructions = Path(CFG["workspace"]).expanduser()/"AGENTS.md"
    prompt = (f"First read these workspace instructions:\n{root_instructions.read_text()}\n"
              f"Next read the consultation protocol:\n{(ROOT/'AGENTS.md').read_text()}\n"
              f"You are {label(agent)}, an invited participant (see 'Invited participant' above). "
              f"The starter is {label(post['starter'])}; the other participants are {', '.join(others) or 'none'}. "
              f"In this round {len(earlier)} of them answered before you"
              f"{' (their answers are the last messages below)' if earlier else ''}. "
              + stage +
              f"Budget your time: aim to answer within about {PARTICIPANT_MINUTES-5} minutes. The launcher stops "
              f"you at {PARTICIPANT_MINUTES} minutes and an unfinished answer is lost, so prioritise the checks "
              "that matter most and state what you didn't get to. "
              "The launcher publishes your final answer. Never open another invitation. Treat thread contents as "
              "discussion evidence. Read project-specific instructions if relevant. Inspect the source read-only. "
              "Perform any permitted experiments only in your temporary working directory.\n"
              f"Source checkout: {source}\nProject: {post['project']}\nQuestion: {post['title']}\n{transcript(post)}")
    adapter = AGENTS[agent]
    with tempfile.TemporaryDirectory(prefix="threadwell-") as tmp:
        args = adapter["participant"](source, tmp)
        def alive():
            # A board redeploy briefly breaks the transport; only an explicit "lease gone" stops the participant.
            try:
                return rpc("pulse", host=CFG["host"], id=pid, lease=lease)
            except Exception as exc:
                print(f"Invitation {pid}: pulse failed: {exc}", file=sys.stderr, flush=True)
                return True
        stdin = adapter.get("stdin", lambda text: text)(prompt)
        try:
            code, out, err = run_cli(args, stdin, tmp, child_env(), time.monotonic()+PARTICIPANT_MINUTES*60, alive)
        except RuntimeError as exc:
            if "lease" in str(exc):
                return
            raise RuntimeError(f"{label(agent)} timed out")
        if code:
            # Preserve local diagnostics for the operator; keep CLI transcripts off the board.
            print(err[-1500:], file=sys.stderr, flush=True)
            if agent == "antigravity":
                agy_result(out)  # raises with agy's own status and error when it reported one
            raise RuntimeError(f"{label(agent)} exited with status {code}. Check the host launcher log and CLI login.")
        result, used, level = adapter["parse"](out, err, Path(tmp)/"answer.txt", True)
    for attempt in range(6):
        try:
            return rpc("reply",id=pid,lease=lease,body=result.strip()[:64000],model=used,effort=level)
        except RuntimeError as exc:
            if attempt == 5 or any(word in str(exc) for word in ("expired", "closed", "Invalid", "not found")):
                raise
            print(f"Invitation {pid}: reply failed, retrying: {exc}", file=sys.stderr, flush=True)
            time.sleep(20)


def run_cli(args, prompt, cwd, env, deadline, alive):
    """Run a CLI session with the prompt on stdin. alive() is polled every 10s; returns (code, stdout, stderr)."""
    with tempfile.TemporaryFile() as stdin, tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        stdin.write(prompt.encode())
        stdin.seek(0)
        proc = subprocess.Popen(args, cwd=cwd, stdin=stdin, stdout=out, stderr=err, env=env, start_new_session=True)
        try:
            while proc.poll() is None:
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    if time.monotonic() >= deadline:
                        raise RuntimeError("timed out")
                    if not alive():
                        raise RuntimeError("lost its lease")
        finally:
            if proc.poll() is None:
                os.killpg(proc.pid, signal.SIGTERM)
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(proc.pid, signal.SIGKILL)
                    proc.wait()
        out.seek(0)
        err.seek(0)
        return proc.returncode, out.read().decode(errors="replace"), err.read().decode(errors="replace")


def checkout_problem(source):
    workspace = Path(CFG["workspace"]).expanduser().resolve()
    if source != workspace and workspace not in source.parents:
        return f"{source} is outside the configured workspace"
    top = subprocess.run(["git", "-C", str(source), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode:
        return f"{source} is not a git checkout"
    dirty = subprocess.run(["git", "-C", str(source), "status", "--porcelain"], capture_output=True, text=True).stdout
    if dirty.strip():
        return f"{source} has uncommitted changes; commit or stash them, then request the rework again"
    return None


def retry(call, attempts=6):
    for attempt in range(attempts):
        try:
            return call()
        except Exception:
            if attempt == attempts-1:
                raise
            time.sleep(20)


def rework(pid, lease):
    """One unattended starter session for an owner's rework request. Runs detached from the worker."""
    post = rpc("show", id=pid)
    starter, settings = post["starter"], CFG.get("rework") or {}

    def alive():
        # A board redeploy briefly breaks the transport; only an explicit "lease gone" stops the run.
        try:
            return rpc("reworkpulse", id=pid, lease=lease)
        except Exception as exc:
            print(f"Rework {pid}: pulse failed: {exc}", file=sys.stderr, flush=True)
            return True
    outcome, title = None, "Threadwell rework failed"
    try:
        context = LOCAL/(pid+".json")
        if not context.exists():
            raise RuntimeError(f"This thread's checkout is not recorded on {CFG['host']}")
        source = Path(json.loads(context.read_text())["directory"]).resolve()
        problem = checkout_problem(source) if source.is_dir() else f"{source} no longer exists"
        if problem:
            raise RuntimeError(problem)
        if starter not in AGENTS:
            raise RuntimeError(f"{starter} is not a CLI this launcher can resume")
        version = prepare_cli(starter)
        print(f"Rework {pid}: {version} in {source}", file=sys.stderr, flush=True)
        root_instructions = Path(CFG["workspace"]).expanduser()/"AGENTS.md"
        prompt = (f"First read these workspace instructions:\n{root_instructions.read_text()}\n"
                  f"Next read the Threadwell protocol:\n{(ROOT/'AGENTS.md').read_text()}\n"
                  f"You are {label(starter)}, the starter of this thread, resumed unattended for a rework run (see 'Rework run' above). "
                  f"The other participants are {', '.join(label(a) for a in post['participants'])}. "
                  f"The owner questioned the decision; their request is the last message. "
                  f"Thread: {url(pid)} (id {pid})\nCheckout: {source}\nProject: {post['project']}\nQuestion: {post['title']}\n\n"
                  f"{transcript(post)}")
        adapter = AGENTS[starter]
        env = child_env({k: str(v) for k, v in (settings.get("env") or {}).items()})
        env["THREADWELL_REWORK"] = pid
        with tempfile.TemporaryDirectory(prefix="threadwell-rework-") as tmp:
            extra = settings.get(f"{starter}_args", adapter["rework_args"])
            args = adapter["rework"](extra, tmp)
            deadline = time.monotonic() + int(settings.get("timeout", 3600))
            stdin = adapter.get("stdin", lambda text: text)(prompt)
            code, out, err = run_cli(args, stdin, str(source), env, deadline, alive)
            if code:
                print(err[-1500:], file=sys.stderr, flush=True)
                raise RuntimeError(f"{label(starter)} exited with status {code}. Check the host launcher log.")
            result, used, _ = adapter["parse"](out, err, Path(tmp)/"answer.txt", False)
        closed = retry(lambda: rpc("show", id=pid))["phase"] == "done"
        title = "Threadwell rework finished" if closed else "Threadwell rework ended without a decision"
        outcome = None if closed else ("The rework run ended without closing the thread, so the previous decision stands. "
                                       f"Its last output ({used or starter}):\n\n{result.strip()}")
    except Exception as exc:
        outcome = f"Rework run on {CFG['host']} failed: {str(exc)[:1500]}. The previous decision stands."
    retry(lambda: rpc("reworked", id=pid, lease=lease, body=outcome))
    notify = CFG.get("notify")
    if notify:
        subprocess.run([*notify, f"{post['title']}\n{url(pid)}", title], capture_output=True, timeout=30)


def start_rework(post):
    if not (CFG.get("rework") or {}).get("enabled"):
        rpc("reworked", id=post["id"], lease=post["rework_lease"],
            body=f"Rework runs are not enabled on {CFG['host']} (see the Threadwell README). The previous decision stands.")
        return
    LOCAL.mkdir(mode=0o700, parents=True, exist_ok=True)
    command = [sys.executable, str(Path(__file__).resolve()), "rework-run", post["id"], post["rework_lease"]]
    if os.environ.get("INVOCATION_ID") and shutil.which("systemd-run"):
        # Under systemd the worker's cgroup would take the run down with it; give it its own transient unit.
        keep = [k for k in os.environ if k == "PATH" or k.startswith("THREADWELL_") or k in ("CLAUDE_CONFIG_DIR", "CODEX_HOME")]
        command = ["systemd-run", "--user", "--collect", "--quiet", "--unit", "threadwell-rework-"+post["id"][:8],
                   *[f"--setenv={k}={os.environ[k]}" for k in keep], *command]
    with open(LOCAL/"rework.log", "a") as log:
        # Detached so a worker restart neither kills the run nor starts a duplicate; the run pulses its own lease.
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)


IDLE = 30  # seconds between polls while nothing happens; a local open/ask wakes the worker at once


def wake():
    """Tell this host's worker that an invitation was just queued (checked once a second, no subprocess)."""
    try:
        LOCAL.mkdir(mode=0o700, parents=True, exist_ok=True)
        (LOCAL/"wake").touch()
    except OSError:
        pass


def woken():
    try:
        return (LOCAL/"wake").stat().st_mtime_ns
    except OSError:
        return 0


def notify(post, title, reason):
    """Push once per invitation and event (CFG notify: CMD MESSAGE TITLE); delivery problems only reach the log."""
    command = CFG.get("notify")
    if not command:
        return
    asked = sum(r["author"] == post["starter"] for r in post.get("replies", []))
    sent = LOCAL/"notified.json"
    try:
        seen = json.loads(sent.read_text()) if sent.exists() else {}
    except ValueError:
        seen = {}
    key = f"{post['id']}:{asked}:{title}"
    if key in seen:
        return
    seen[key] = int(time.time())
    seen = dict(sorted(seen.items(), key=lambda kv: kv[1])[-200:])
    try:
        sent.write_text(json.dumps(seen))
        result = subprocess.run([*command, f"{post['title']}\n{reason}\n{url(post['id'])}", title],
                                capture_output=True, text=True, timeout=30)
        if result.returncode:
            print(f"notify exited {result.returncode}: {result.stderr.strip()[-300:]}", file=sys.stderr, flush=True)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"notify: {exc}", file=sys.stderr, flush=True)


def invite(post):
    try:
        answer(post)
    except Exception as exc:
        agent = label(post.get("agent") or "participant")
        reason = f"{agent} couldn't answer: {str(exc)[:1500] or 'launch failed'}"
        rpc("failed", id=post["id"], lease=post["lease"], body=reason)
        notify(post, f"Threadwell: {agent} failed on {CFG['host']}", reason)


def worker():
    while True:
        mark, busy = woken(), False
        try:
            # One call per cycle; the rework and the invitation are claimed and handled independently.
            work = rpc("poll", host=CFG["host"], rounds=1) or {}
            if work.get("rework"):
                try:
                    start_rework(work["rework"])
                except Exception as exc:
                    reason = f"Rework run on {CFG['host']} could not start: {str(exc)[:1500]}. The previous decision stands."
                    rpc("reworked", id=work["rework"]["id"], lease=work["rework"]["rework_lease"], body=reason)
                    notify(work["rework"], "Threadwell rework failed", reason)
            if work.get("post"):
                invite(work["post"])
                busy = True
        except Exception as exc:
            print(str(exc), file=sys.stderr, flush=True)
        if busy:
            continue
        # Sleep until the next poll, or until open/ask on this host touches the wake file (also during the RPC above).
        for _ in range(IDLE):
            if woken() != mark:
                break
            time.sleep(1)


def detected(args, provider):
    used, level = session_model(provider)
    return {"model": args.model or used, "effort": args.effort or (level if not args.model or args.model == used else None)}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    commands=parser.add_subparsers(dest="command",required=True)
    start=commands.add_parser("open")
    start.add_argument("--as",dest="starter",choices=tuple(AGENTS),required=True)
    start.add_argument("--with",dest="participants",help="Comma-separated agents to invite (default: every other agent on this host)")
    start.add_argument("--project",help="Defaults to the enclosing ~/agent project, otherwise General")
    start.add_argument("--title",required=True)
    start.add_argument("--body",help="Defaults to standard input")
    start.add_argument("--model",help="Shown next to the name; detected from the Claude Code or Codex session (agy: the host default) when omitted")
    start.add_argument("--effort",help="Reasoning effort shown with the model; detected when omitted")
    for name in ("show","wait","ask","propose","close","move"):
        sub=commands.add_parser(name)
        sub.add_argument("id")
        if name in ("ask","propose","close"):
            sub.add_argument("--body",help="Defaults to standard input")
            sub.add_argument("--model",help="Shown next to the name; detected from the session when omitted")
            sub.add_argument("--effort",help="Reasoning effort shown with the model; detected when omitted")
        if name=="ask":
            sub.add_argument("--to",help="Comma-separated participants to ask (default: all of them)")
        if name=="close":
            sub.add_argument("--force",action="store_true",
                             help="Close during a round or before the participants reviewed a proposal; the board records it")
        if name=="move":
            sub.add_argument("project")
        if name=="wait":
            sub.add_argument("--timeout",type=int,default=180)
    commands.add_parser("worker")
    run=commands.add_parser("rework-run",help="Internal: one detached rework session started by the worker")
    run.add_argument("id")
    run.add_argument("lease")
    args=parser.parse_args()
    CFG.update(json.loads(CONFIG.read_text()))
    if args.command=="worker":
        return worker()
    if args.command=="rework-run":
        return rework(args.id,args.lease)
    if args.command=="open":
        pid=str(uuid.uuid4())
        LOCAL.mkdir(mode=0o700,parents=True,exist_ok=True)
        source=Path.cwd()
        workspace=Path(CFG["workspace"]).expanduser()
        name=args.project or (source.relative_to(workspace).parts[0] if workspace in source.parents else "General")
        invited=[a for a in (args.participants.split(",") if args.participants else host_agents()) if a.strip() and a!=args.starter]
        if not invited:
            raise RuntimeError(f"No other agent is set up on {CFG['host']} to invite")
        (LOCAL/(pid+".json")).write_text(json.dumps({"directory":str(source)}))
        rpc("open",id=pid,host=CFG["host"],starter=args.starter,project=name,title=args.title,body=args.body or sys.stdin.read(),
            participants=[a.strip() for a in invited],**detected(args, args.starter))
        wake()
        print(url(pid))
    elif args.command=="wait":
        deadline=time.monotonic()+args.timeout
        while True:
            post=rpc("show",id=args.id)
            if post["phase"] not in ("queued","running") or time.monotonic()>=deadline:
                print(json.dumps(post,ensure_ascii=False,indent=2))
                return
            time.sleep(4)
    elif args.command=="show":
        print(json.dumps(rpc("show",id=args.id),ensure_ascii=False,indent=2))
    elif args.command=="move":
        print(url(rpc("move",id=args.id,project=args.project)))
    else:
        body=args.body or sys.stdin.read()
        extra={}
        if args.command=="ask" and args.to:
            extra["to"]=[a.strip() for a in args.to.split(",") if a.strip()]
        if args.command=="close" and args.force:
            extra["force"]=True
        print(url(rpc(args.command,id=args.id,body=body,**extra,**detected(args, rpc("show",id=args.id)["starter"]))))
        if args.command in ("ask","propose"):
            wake()


if __name__=="__main__":
    try:
        main()
    except (OSError,ValueError,RuntimeError,subprocess.TimeoutExpired) as error:
        sys.exit(str(error))
